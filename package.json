{
  "name": "hello-world-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A hello-world Claude agent reachable as a WhatsApp chat handle via the Meta WhatsApp Cloud API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "whatsapp:setup": "node --experimental-strip-types src/setup/run.ts",
    "whatsapp:check": "node --experimental-strip-types src/setup/run.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
