# Port the webhook server listens on.
PORT=3000

# A random string you invent. Paste the same value into the Meta app's
# webhook configuration form so Meta can prove it is talking to you.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# Meta app secret: App Dashboard -> App settings -> Basic -> App Secret.
WHATSAPP_APP_SECRET=

# WhatsApp -> API Setup -> "Phone number ID" of your business number.
WHATSAPP_PHONE_NUMBER_ID=

# Permanent system-user token with the whatsapp_business_messaging permission
# (the 24-hour temporary token from API Setup works for a first test).
WHATSAPP_ACCESS_TOKEN=

# Optional: pin the Graph API version.
GRAPH_API_VERSION=v23.0

# Anthropic API key. Without it the agent replies with a canned greeting.
ANTHROPIC_API_KEY=
