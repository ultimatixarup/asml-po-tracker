# --- Server ---------------------------------------------------------------
# Port the webhook server listens on.
PORT=3000

# --- Meta / WhatsApp Cloud API --------------------------------------------
# A random string you invent. Used for the webhook handshake; the setup script
# hands the same value to Meta.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# App Dashboard -> App settings -> Basic.
META_APP_ID=
WHATSAPP_APP_SECRET=

# WhatsApp -> API Setup. The phone number ID is the handle that replies;
# the business account ID owns it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# System-user token with whatsapp_business_messaging (to send) and
# whatsapp_business_management (to subscribe the webhook).
WHATSAPP_ACCESS_TOKEN=

# Optional: pin the Graph API version.
GRAPH_API_VERSION=v23.0

# --- Deployment -----------------------------------------------------------
# Public HTTPS base URL of the deployed service, no trailing slash. Only the
# setup script reads this; the server itself does not need it.
PUBLIC_URL=

# --- Telegram (optional channel) ------------------------------------------
# Bot token from @BotFather. Set it and the same agent is reachable on
# Telegram too -- long polling, so no public URL or webhook is needed.
TELEGRAM_BOT_TOKEN=

# --- Persistence (optional; in-memory without them) -----------------------
# Postgres for the ledger, estimates, change orders, and chat history.
DATABASE_URL=

# S3-compatible blob storage for photos/receipts/plans (Tigris on Fly).
# All four required together; AWS_ENDPOINT_URL_S3 for non-AWS providers.
BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=

# Token that gates the read-only /audit pages. Unset disables them.
AUDIT_TOKEN=

# --- Agent ----------------------------------------------------------------
# Anthropic API key. Without it the agent replies with a canned greeting.
ANTHROPIC_API_KEY=
